<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prestamo_equipo_list_view" model="ir.ui.view">
        <field name="name">unicah.prestamo.equipo.list</field>
        <field name="model">unicah.prestamo.equipo</field>
        <field name="arch" type="xml">
            <list string="Préstamos de equipos">
                <field name="name"/>
                <field name="solicitante_id"/>
                <field name="codigo_equipo"/>
                <field name="fecha_prestamo"/>
                <field name="fecha_devolucion"/>
                <field name="dias_prestamo"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="prestamo_equipo_form_view" model="ir.ui.view">
        <field name="name">unicah.prestamo.equipo.form</field>
        <field name="model">unicah.prestamo.equipo</field>
        <field name="arch" type="xml">
            <form string="Préstamo de equipo">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="solicitante_id"/>
                            <field name="codigo_equipo"/>
                            <field name="descripcion_equipo"/>
                        </group>
                        <group>
                            <field name="fecha_prestamo"/>
                            <field name="fecha_devolucion"/>
                            <field name="dias_prestamo" readonly="1"/>
                            <field name="estado"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="observaciones" placeholder="Detalles del estado del equipo..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="prestamo_equipo_action" model="ir.actions.act_window">
        <field name="name">Préstamos de equipos</field>
        <field name="res_model">unicah.prestamo.equipo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="unicah_prestamos_root" name="Préstamos UNICAH" sequence="70"/>
    <menuitem id="unicah_prestamos_menu" name="Préstamos de equipos"
              parent="unicah_prestamos_root" action="prestamo_equipo_action"
              sequence="10"/>
</odoo>
