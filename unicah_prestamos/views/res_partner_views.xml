<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_prestamos_unicah" model="ir.ui.view">
        <field name="name">res.partner.form.unicah.prestamos</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="unicah_prestamos" string="Préstamos UNICAH">
                    <group>
                        <field name="prestamo_count" readonly="1"/>
                    </group>
                    <field name="prestamo_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="codigo_equipo"/>
                            <field name="fecha_prestamo"/>
                            <field name="fecha_devolucion"/>
                            <field name="estado"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
